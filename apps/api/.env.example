# Copy to .env for local dev (npm run dev -w shelf-sense-api). Points at the
# `db` service from the repo's docker-compose.yml published to localhost —
# run `docker compose up -d db` first. In the Docker image itself this is
# set directly as a container env var (DATABASE_URL uses the in-network
# hostname "db", not localhost) — see docker-compose.yml.
DATABASE_URL=postgres://shelf:shelf@localhost:5432/shelfsense

# Optional — specs/Advanced Settings.md. Pre-configures AI/Tavily
# credentials so barcode-lookup AI extraction (specs/Barcode Scanner &
# Product info scrape.md) works without the user having to save their own
# key in Settings first. Each is independent, and a user's own
# Settings-saved value (if any) always overrides its matching one here.
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# TAVILY_API_KEY=
