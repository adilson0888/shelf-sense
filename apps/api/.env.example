# Copy to .env for local dev (npm run dev -w shelf-sense-api). Points at the
# `db` service from the repo's docker-compose.yml published to localhost —
# run `docker compose up -d db` first.
#
# Two supported ways to configure the database connection (see
# specs/Database Configuration.md) — pick one:

# 1. Discrete variables — the default below, and the recommended path for
#    most self-hosted setups. DB_PORT defaults to 5432 if omitted; the
#    other four have no default and must all be set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shelfsense
DB_USER=shelf
DB_PASSWORD=shelf

# 2. A single connection string — takes precedence over the discrete
#    variables above if set (useful if you already have one, e.g. from a
#    managed Postgres provider). Uncomment to use it instead:
# DATABASE_URL=postgres://shelf:shelf@localhost:5432/shelfsense
